DB_NAME=gatestack
DB_HOST=host.docker.internal
DB_PORT=3306

MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_APP_USER=gatestack_app
MYSQL_APP_PASSWORD=replace-with-generated-password

GATESTACK_DB_USER=gatestack_app
GATESTACK_DB_PASSWORD=replace-with-generated-password
GATEWIKI_DB_USER=gatewiki_app
GATEWIKI_DB_PASSWORD=replace-with-generated-password
GATESTORAGE_DB_USER=gatestorage_app
GATESTORAGE_DB_PASSWORD=replace-with-generated-password

SECRET_KEY=replace-with-at-least-32-random-characters
DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=gatewiki-assistant
OLLAMA_TIMEOUT_SECONDS=45

# Vacio usa automaticamente el hostname desde el que abres la plataforma.
VITE_SERVER_HOST=
VITE_SERVER_PROTOCOL=http
VITE_GATESTACK_BACKEND_PORT=8000
VITE_GATEWIKI_BACKEND_PORT=8001
VITE_GATESTORAGE_BACKEND_PORT=8002

# Overrides opcionales si un servicio usa otro host o dominio.
# VITE_API_BASE_URL=https://auth.empresa.local
# VITE_GATEWIKI_BACKEND_URL=https://wiki.empresa.local
# VITE_GATESTORAGE_BACKEND_URL=https://storage.empresa.local
