APP_NAME=video-watcher
ENVIRONMENT=local

# Local, non-Docker MySQL. Fill DB_PASSWORD with the password from your real machine.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gatestack
DB_USER=root
DB_PASSWORD=

# GateStack must be running outside Docker too.
GATESTACK_API_URL=http://127.0.0.1:8000
GATESTACK_FALLBACK_URLS=http://localhost:8000,http://192.168.1.150:8000

# Local storage and tools.
VIDEO_WATCHER_DATA_ROOT=./data
FFMPEG_PATH=ffmpeg

# Keep mock while wiring the review/dataset workflow.
LLM_PROVIDER=mock
LLM_MODEL=mock-vision-verifier
DEFAULT_SAMPLE_FPS=1
